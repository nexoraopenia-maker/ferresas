// ============================================================================
//  FerreSaaS — Prisma Schema
//  SaaS multi-tenant para ferreterías.
//
//  ESTRATEGIA MULTI-TENANT: shared database / shared schema.
//  Toda tabla de negocio lleva `tenantId` como primer FK después del `id`.
//
//  DEFENSA EN PROFUNDIDAD (3 capas):
//   1. Sesión/middleware  -> resuelve tenantId + role (nunca desde el cliente).
//   2. Server Action      -> revalida tenantId, role y estado de suscripción.
//   3. Base de datos      -> este schema: FKs COMPUESTAS (tenantId, id).
//      Un SaleItem no puede apuntar a un Product de otro tenant porque la FK
//      es (tenantId, productId) -> Product(tenantId, id). El aislamiento deja
//      de depender de que el desarrollador recuerde el `where`.
// ============================================================================

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  /**
   * `relationJoins` resuelve las relaciones anidadas con LATERAL JOIN en UNA
   * sola sentencia, en lugar de una consulta por relación.
   * No es una optimización teórica. Medido: la consulta de sesión —la que
   * corre en CADA navegación— costaba 3,2 idas y vueltas porque Prisma la
   * partía en tres (usuario, tenant+suscripción, sucursales). Desde un
   * portátil con 148 ms de latencia eso son 474 ms; en producción, con 14 ms,
   * son 45 ms que parecen «una consulta lenta» cuando en realidad son tres
   * consultas rápidas una detrás de otra.
   */
  previewFeatures = ["relationJoins"]
}

// Prisma 7: la conexión ya NO se declara aquí.
//  - CLI (migrate/db/studio)  -> prisma.config.ts  (datasource.url)
//  - Runtime (PrismaClient)   -> driver adapter pasado al constructor
//    (@prisma/adapter-pg). Pendiente: se cablea en la Fase 5.
datasource db {
  provider = "postgresql"
}

// ============================================================================
//  ENUMS
// ============================================================================

/// SUPERADMIN es el dueño del SaaS: es el ÚNICO rol con tenantId nulo y el
/// único autorizado a consultar entre tenants (siempre vía módulo auditado).
enum Role {
  SUPERADMIN
  OWNER
  ADMIN
  ALMACENERO
  /**
   * Atiende el mostrador: arma el pedido y cotiza. NO cobra.
   * Separar «armar» de «cobrar» es lo que permite el relevo vendedor →
   * cajero sin que el vendedor toque el dinero.
   */
  VENDEDOR
  /**
   * Cobra, abre y cierra caja y emite comprobantes. NO ve costos.
   */
  CAJERO
  /**
   * Solo lectura: reportes, comprobantes y arqueos. SÍ ve costos.
   */
  CONTADOR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentProvider {
  STRIPE
  MERCADOPAGO
  MANUAL
}

/// Qué puede hacer el tenant según su estado de cuenta. Se calcula en el
/// servidor a partir de Subscription.status + días de mora; nunca en la UI.
enum AccessLevel {
  FULL
  WARN
  READ_ONLY
  BLOCKED
}

enum UnitType {
  UNIDAD
  KILOGRAMO
  GRAMO
  METRO
  CENTIMETRO
  LITRO
  GALON
  CAJA
  PAQUETE
  DOCENA
  MILLAR
  ROLLO
  PLANCHA
  BOLSA
  JUEGO
  PAR
  SERVICIO
}

/// Tipos de movimiento de inventario. La cantidad en StockMovement es SIGNADA:
/// positiva para entradas, negativa para salidas.
enum MovementType {
  INICIAL
  ENTRADA
  SALIDA
  AJUSTE
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SALIDA
  VENTA
  DEVOLUCION_CLIENTE
  DEVOLUCION_PROVEEDOR
  MERMA
}

enum MovementSource {
  MANUAL
  ESCANER
  VENTA
  COMPRA
  TRANSFERENCIA
  IMPORTACION
  CONTEO
}

enum SaleStatus {
  BORRADOR
  COMPLETADA
  ANULADA
  DEVUELTA
}

enum QuoteStatus {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
  CONVERTIDA
}

enum PurchaseStatus {
  BORRADOR
  RECIBIDA
  ANULADA
}

enum DocumentType {
  NOTA_VENTA
  BOLETA
  FACTURA
  TICKET
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  TRANSFERENCIA
  YAPE
  PLIN
  CREDITO
  OTRO
}

enum CustomerDocType {
  DNI
  RUC
  CE
  PASAPORTE
  SIN_DOCUMENTO
}

/**
 * Estado de una merma solicitada.
 * Existe porque una merma reduce inventario a criterio de quien la registra,
 * y eso es la forma más fácil de tapar un faltante. Se pide y se aprueba por
 * separado: misma regla que en transferencias — quien pide no autoriza.
 */
enum MermaStatus {
  /// Solicitada. El stock NO se ha movido.
  PENDIENTE
  /// Aprobada: el stock ya se descontó.
  APROBADA
  /// Rechazada con motivo. El stock nunca se movió.
  RECHAZADA
}

/// Estado del turno de caja de una sucursal.
enum CashSessionStatus {
  ABIERTA
  CERRADA
}

/**
 * Ciclo de vida de una transferencia entre sucursales.
 * Los estados intermedios no son burocracia: el stock sale del origen cuando
 * se despacha y entra al destino cuando se recibe. Entre ambos momentos la
 * mercadería está EN_TRANSITO y no pertenece a ningún almacén — la fila de la
 * transferencia es su único registro. Sin ese estado, o el origen sigue
 * contando lo que ya salió, o el destino cuenta lo que todavía no llegó.
 */
enum TransferStatus {
  BORRADOR
  SOLICITADA
  APROBADA
  EN_TRANSITO
  RECIBIDA
  /// El destino la rechaza al recibirla: el stock vuelve al origen.
  RECHAZADA
  CANCELADA
}

/// Política del tenant cuando una venta excede el stock disponible (§5.4).
enum StockPolicy {
  BLOQUEAR
  PERMITIR_CON_ADVERTENCIA
}

/**
 * Estado del comprobante frente a la administración tributaria.
 * PENDIENTE y ACEPTADO son los dos que pidió el negocio; los otros tres
 * existen porque sin ellos el flujo real no se puede representar: un
 * comprobante enviado del que aún no hay respuesta no es lo mismo que uno
 * sin enviar, y uno rechazado necesita que alguien lo corrija a mano.
 */
enum TaxDocumentStatus {
  /// Emitido localmente, todavía no enviado.
  PENDIENTE
  /// Enviado; esperando respuesta.
  ENVIADO
  /// Aceptado por la administración.
  ACEPTADO
  /// Rechazado: requiere corrección manual.
  RECHAZADO
  /// Anulado (en Perú, mediante nota de crédito).
  ANULADO
}

enum WebhookStatus {
  RECIBIDO
  PROCESADO
  FALLIDO
  IGNORADO
}

// ============================================================================
//  FACTURACIÓN — Plan es global (sin tenantId): lo define el dueño del SaaS.
// ============================================================================

model Plan {
  id          String  @id @default(cuid())
  code        String  @unique // "free" | "basico" | "pro" | "empresa"
  name        String
  description String?

  priceMonthly Decimal @db.Decimal(12, 2)
  priceYearly  Decimal @db.Decimal(12, 2)
  currency     String  @default("PEN")

  // Identificadores del proveedor de pagos (fuente de verdad: el webhook).
  stripeProductId    String?
  stripePriceMonthly String?
  stripePriceYearly  String?
  mercadoPagoPlanId  String?

  // Límites del plan. NULL = ilimitado. Se aplican al CREAR el recurso
  // (Server Action), no solo en la UI (§5.2).
  maxUsers               Int?
  maxBranches            Int?
  maxWarehouses          Int?
  maxProducts            Int?
  maxMonthlyTransactions Int?

  trialDays Int     @default(14)
  features  Json?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants       Tenant[]
  subscriptions Subscription[]

  @@index([isActive, sortOrder])
  @@map("plans")
}

// ============================================================================
//  TENANT — la ferretería. Raíz del árbol de aislamiento.
// ============================================================================

model Tenant {
  id   String @id @default(cuid())
  slug String @unique // subdominio / path del tenant

  name      String
  legalName String?
  /**
   * RUC. Único en todo el SaaS, no solo por tenant.
   * Un RUC identifica a UNA persona jurídica. Dos cuentas con el mismo RUC
   * serían o un alta duplicada o un error de tecleo, y el problema no es
   * cosmético: el RUC va impreso en los comprobantes, así que dos cuentas
   * emitiendo bajo el mismo RUC con series independientes producirían
   * correlativos solapados para un mismo contribuyente. Eso es una
   * contingencia tributaria, no un duplicado molesto.
   * Nullable: en Postgres los NULL no colisionan entre sí, así que las
   * cuentas que aún no han declarado su RUC conviven sin problema.
   */
  taxId     String? @unique
  email     String?
  phone     String?
  address   String?
  /**
   * Ubigeo INEI del domicilio fiscal. Va en el XML del comprobante como
   * dirección del emisor, así que sin esto no se puede emitir.
   */
  ubigeo    String?
  logoUrl   String?

  currency String  @default("PEN")
  timezone String  @default("America/Lima")
  locale   String  @default("es-PE")
  /// IGV por defecto para productos nuevos (18% en Perú).
  taxRate  Decimal @default(0.1800) @db.Decimal(5, 4)

  /// Kill switch del Super Admin. Independiente del estado de suscripción:
  /// un tenant puede estar ACTIVE en Stripe y aun así suspendido por abuso.
  isActive        Boolean   @default(true)
  suspendedAt     DateTime?
  suspendedReason String?

  /// §5.4 — qué hacer si la venta excede el stock disponible.
  stockPolicy StockPolicy @default(BLOQUEAR)

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  subscription   Subscription?
  users          User[]
  branches       Branch[]
  userBranches   UserBranch[]
  cashSessions   CashSession[]
  mermas         Merma[]
  transfers      BranchTransfer[]
  transferItems  BranchTransferItem[]
  warehouses     Warehouse[]
  categories     Category[]
  products       Product[]
  variants       ProductVariant[]
  stocks         Stock[]
  movements      StockMovement[]
  customers      Customer[]
  suppliers      Supplier[]
  sales          Sale[]
  saleItems      SaleItem[]
  payments       Payment[]
  quotes         Quote[]
  quoteItems     QuoteItem[]
  purchases      Purchase[]
  purchaseItems  PurchaseItem[]
  taxDocuments   TaxDocument[]
  counters       DocumentCounter[]
  usage          UsagePeriod[]
  auditLogs      AuditLog[]
  impersonations ImpersonationSession[]
  webhookEvents  WebhookEvent[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("tenants")
}

// ============================================================================
//  SUSCRIPCIÓN — el webhook del proveedor es la ÚNICA fuente de verdad (§5.2).
//  Nada en la app escribe `status` salvo el handler del webhook.
// ============================================================================

model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  provider PaymentProvider    @default(STRIPE)
  status   SubscriptionStatus @default(TRIALING)

  externalCustomerId     String?
  externalSubscriptionId String? @unique
  externalPriceId        String?

  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  /// Marca de inicio de mora. El bloqueo progresivo (§5.2) se calcula como
  /// now() - pastDueSince > graceDays  ->  READ_ONLY.
  pastDueSince DateTime?
  graceDays    Int       @default(7)

  lastPaymentAt     DateTime?
  lastPaymentAmount Decimal?  @db.Decimal(12, 2)
  /// Último evento del proveedor aplicado: descarta webhooks fuera de orden.
  lastEventId       String?
  lastEventAt       DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([status, currentPeriodEnd])
  @@index([externalCustomerId])
  @@map("subscriptions")
}

/// Log crudo de webhooks. `externalEventId` único = idempotencia:
/// reintentos del proveedor no duplican cobros ni cambios de estado.
model WebhookEvent {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  provider        PaymentProvider
  externalEventId String
  type            String
  payload         Json
  status          WebhookStatus   @default(RECIBIDO)
  error           String?
  attempts        Int             @default(0)
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@unique([provider, externalEventId])
  @@index([status, createdAt])
  @@index([tenantId, createdAt])
  @@map("webhook_events")
}

// ============================================================================
//  USUARIOS Y AUTENTICACIÓN (NextAuth)
// ============================================================================

model User {
  id String @id @default(cuid())

  /// NULL únicamente para SUPERADMIN (§5.3). Cualquier otro rol con
  /// tenantId nulo es un bug de datos: validar en el callback de sesión.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String
  phone         String?
  image         String?

  role     Role    @default(VENDEDOR)
  isActive Boolean @default(true)

  /**
   * Momento del último cambio de contraseña.
   * Existe por una razón concreta: la estrategia de sesión es JWT, y un JWT
   * es válido hasta que caduca. Sin esta columna, cambiar la contraseña NO
   * echa a quien ya tenga una sesión abierta — justo lo que uno espera al
   * cambiarla porque sospecha que se la robaron.
   * La sesión guarda su `iat`; si es anterior a esta marca, se rechaza. Así
   * el cambio de contraseña revoca de verdad lo que había.
   */
  passwordChangedAt DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  accounts        Account[]
  sessions        Session[]
  branches        UserBranch[]
  managedBranches Branch[]               @relation("BranchManager")
  mermasPedidas   Merma[]                @relation("MermaRequestedBy")
  mermasResueltas Merma[]                @relation("MermaResolvedBy")
  cashOpened      CashSession[]          @relation("CashOpenedBy")
  cashClosed      CashSession[]          @relation("CashClosedBy")
  transfersAsked  BranchTransfer[]       @relation("TransferRequestedBy")
  transfersOked   BranchTransfer[]       @relation("TransferApprovedBy")
  transfersGot    BranchTransfer[]       @relation("TransferReceivedBy")
  movements       StockMovement[]
  sales           Sale[]
  payments        Payment[]
  quotes          Quote[]
  purchases       Purchase[]
  auditLogs       AuditLog[]             @relation("AuditActor")
  impersonations  ImpersonationSession[] @relation("Impersonator")
  impersonated    ImpersonationSession[] @relation("Impersonated")

  @@unique([tenantId, id])
  @@index([tenantId, role])
  @@index([tenantId, isActive])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
//  CATÁLOGO
// ============================================================================

model Warehouse {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /**
   * Sucursal a la que pertenece. Una sucursal puede tener varios almacenes
   * (sala de ventas y depósito), pero un almacén está en una sola sucursal:
   * de otro modo no se sabría a qué establecimiento declarar su inventario.
   * `Restrict` y no `Cascade`: borrar una sucursal con inventario dentro
   * debe fallar, no evaporar el stock.
   */
  branchId String
  branch   Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  code      String
  name      String
  address   String?
  phone     String?
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stocks    Stock[]
  movements StockMovement[]
  sales     Sale[]
  quotes    Quote[]
  purchases Purchase[]
  mermas    Merma[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, branchId, isActive])
  @@index([tenantId, isActive])
  @@map("warehouses")
}

model Category {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String
  slug String

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
  @@map("categories")
}

model Supplier {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String
  taxId   String?
  contact String?
  phone   String?
  email   String?
  address String?
  notes   String?

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products  Product[]
  purchases Purchase[]

  @@unique([tenantId, id])
  @@unique([tenantId, taxId])
  @@index([tenantId, name])
  @@map("suppliers")
}

model Customer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  docType   CustomerDocType @default(SIN_DOCUMENTO)
  docNumber String?
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?

  creditLimit Decimal @default(0) @db.Decimal(12, 2)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sales  Sale[]
  quotes Quote[]

  @@unique([tenantId, id])
  @@unique([tenantId, docType, docNumber])
  @@index([tenantId, name])
  @@index([tenantId, phone])
  @@map("customers")
}

model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  supplierId String?
  supplier   Supplier? @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  sku     String
  /// Código de barras del fabricante (EAN/UPC/CODE-128), leído con
  /// @zxing/browser. Índice dedicado: el escaneo debe resolver en una sola
  /// query por (tenantId, barcode).
  barcode String?
  /**
   * Código QR propio del negocio.
   * Va en una columna aparte y no reutiliza `barcode` porque conviven: el
   * EAN lo trae el fabricante impreso en el empaque, y el QR lo imprime la
   * ferretería para lo que no viene etiquetado —tornillos a granel, tubería
   * cortada, mercadería de proveedor informal—. Un solo campo obligaría a
   * elegir cuál de los dos guardar.
   * NOTA DE DISEÑO: lo correcto a largo plazo es una tabla ProductCode
   * (un producto, N códigos con su tipo), porque un mismo producto llega con
   * EAN distinto según proveedor y el de la caja no es el de la unidad. Dos
   * columnas cubren el caso de hoy sin esa migración; cuando aparezca el
   * tercer código, toca hacerla.
   */
  qrCode  String?

  name        String
  description String?
  brand       String?
  imageUrl    String?

  unitType UnitType @default(UNIDAD)

  costPrice Decimal @default(0) @db.Decimal(12, 4)
  salePrice Decimal @default(0) @db.Decimal(12, 4)
  taxRate   Decimal @default(0.1800) @db.Decimal(5, 4)

  /// Umbrales del semáforo (§5.1): rojo <= 0, ámbar <= minStock, verde resto.
  minStock Decimal  @default(0) @db.Decimal(14, 4)
  maxStock Decimal? @db.Decimal(14, 4)

  /// false para servicios (mano de obra, corte, delivery): no mueven stock.
  trackStock  Boolean @default(true)
  hasVariants Boolean @default(false)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  variants      ProductVariant[]
  stocks        Stock[]
  movements     StockMovement[]
  saleItems     SaleItem[]
  quoteItems    QuoteItem[]
  purchaseItems PurchaseItem[]
  transferItems BranchTransferItem[]
  mermas        Merma[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@unique([tenantId, qrCode])
  @@index([tenantId, isActive, name])
  @@index([tenantId, categoryId])
  @@index([tenantId, deletedAt])
  @@map("products")
}

model ProductVariant {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  sku        String
  barcode    String?
  /// QR propio del negocio, igual que en Product.
  qrCode     String?
  /// Nombre visible de la variante: "1/2 pulgada", "Rojo", "3m".
  name       String
  /// Atributos estructurados: { "medida": "1/2\"", "color": "rojo" }
  attributes Json?

  costPrice Decimal? @db.Decimal(12, 4)
  salePrice Decimal? @db.Decimal(12, 4)
  minStock  Decimal  @default(0) @db.Decimal(14, 4)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stocks        Stock[]
  movements     StockMovement[]
  saleItems     SaleItem[]
  quoteItems    QuoteItem[]
  purchaseItems PurchaseItem[]
  transferItems BranchTransferItem[]
  mermas        Merma[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@unique([tenantId, qrCode])
  @@index([tenantId, productId])
  @@map("product_variants")
}

// ============================================================================
//  INVENTARIO
// ============================================================================

/// Stock por (producto|variante) + almacén. Es un CACHÉ materializado del
/// ledger StockMovement: se actualiza SIEMPRE dentro del mismo
/// prisma.$transaction que inserta el movimiento (§6.2). Nunca por separado.
model Stock {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  warehouseId String
  warehouse   Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  variantId String?
  variant   ProductVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  quantity Decimal @default(0) @db.Decimal(14, 4)
  /// Reservado por cotizaciones aceptadas / ventas en curso.
  /// Disponible = quantity - reserved.
  reserved Decimal @default(0) @db.Decimal(14, 4)

  /// Override del mínimo a nivel de almacén; si es NULL manda Product.minStock.
  minStock Decimal? @db.Decimal(14, 4)

  /// Bloqueo optimista para el UI optimista del móvil (§5.1): el cliente
  /// envía la versión que leyó y el servidor rechaza si ya cambió.
  version Int @default(0)

  lastCountedAt  DateTime?
  lastMovementAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OJO: PostgreSQL trata cada NULL como distinto, así que este @@unique NO
  // impide dos filas de stock para el mismo producto sin variante. La
  // migración debe añadir a mano el índice parcial que sí lo impide:
  //   CREATE UNIQUE INDEX stocks_no_variant_uniq ON stocks
  //     ("tenantId", "warehouseId", "productId") WHERE "variantId" IS NULL;
  @@unique([tenantId, warehouseId, productId, variantId])
  @@index([tenantId, productId])
  @@index([tenantId, warehouseId])
  @@map("stocks")
}

/// Ledger inmutable de inventario. NUNCA se hace UPDATE ni DELETE: un error
/// se corrige con un movimiento de AJUSTE que lo compensa.
/// `quantity` es SIGNADA: SUM(quantity) por (producto, almacén) === Stock.quantity.
model StockMovement {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  warehouseId String
  warehouse   Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  variantId String?
  variant   ProductVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  /// Quién lo hizo. FK simple a User (User.tenantId es nullable por el
  /// SUPERADMIN, así que no admite FK compuesta): la coincidencia de tenant
  /// se valida en la Server Action.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  type   MovementType
  source MovementSource @default(MANUAL)

  quantity     Decimal  @db.Decimal(14, 4)
  /// Snapshot del stock resultante: permite auditar sin recalcular el ledger.
  balanceAfter Decimal  @db.Decimal(14, 4)
  unitCost     Decimal? @db.Decimal(12, 4)

  /// Obligatorio para AJUSTE y MERMA (§6.6). Se valida con Zod, no aquí.
  reason String?

  /// Documento que originó el movimiento (venta, compra, transferencia).
  referenceType   String?
  referenceId     String?
  /// Une las dos piernas (SALIDA + ENTRADA) de una transferencia.
  transferGroupId String?

  /// Clave de idempotencia enviada por el móvil: si la red falla y el cliente
  /// reintenta, el mismo movimiento no se aplica dos veces (§5.1).
  idempotencyKey String?

  createdAt DateTime @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, productId, createdAt])
  @@index([tenantId, warehouseId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, referenceType, referenceId])
  @@index([transferGroupId])
  @@map("stock_movements")
}

// ============================================================================
//  PUNTO DE VENTA
// ============================================================================

model Sale {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /**
   * Sucursal que emitió la venta. Se guarda aunque sea derivable del
   * almacén: la serie del comprobante depende de la sucursal, y si mañana el
   * almacén se reasigna a otra sucursal, la venta ya emitida tiene que
   * seguir diciendo desde dónde se emitió.
   */
  branchId String
  branch   Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  warehouseId String
  warehouse   Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  /// Turno de caja en el que se cobró. NULL en ventas registradas sin caja
  /// abierta (o anteriores a que existiera el arqueo).
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  customerId String?
  customer   Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  quoteId String?
  quote   Quote?  @relation("QuoteToSale", fields: [tenantId, quoteId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  /// Correlativo por tenant (ver DocumentCounter). Único dentro del tenant.
  number       String
  documentType DocumentType @default(NOTA_VENTA)
  status       SaleStatus   @default(BORRADOR)

  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal @default(0) @db.Decimal(14, 2)
  total         Decimal @default(0) @db.Decimal(14, 2)
  currency      String  @default("PEN")

  /// Se marcó como vendida por debajo del stock disponible (§5.4,
  /// política PERMITIR_CON_ADVERTENCIA). Útil para auditar quiebres.
  soldBelowStock Boolean @default(false)

  notes       String?
  completedAt DateTime?
  voidedAt    DateTime?
  voidReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       SaleItem[]
  payments    Payment[]
  taxDocument TaxDocument?

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  // Relación 1-1 con Quote: una cotización se convierte en una sola venta.
  @@unique([tenantId, quoteId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, warehouseId, createdAt])
  @@index([tenantId, branchId, status, createdAt])
  @@index([tenantId, cashSessionId])
  @@map("sales")
}

/// Los campos *Snapshot congelan nombre y costo al momento de la venta:
/// si el producto cambia de precio o se borra, el histórico no se altera.
model SaleItem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  saleId String
  sale   Sale   @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  variantId String?
  variant   ProductVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  nameSnapshot String
  skuSnapshot  String
  unitType     UnitType @default(UNIDAD)

  quantity  Decimal @db.Decimal(14, 4)
  unitPrice Decimal @db.Decimal(12, 4)
  discount  Decimal @default(0) @db.Decimal(12, 4)
  taxRate   Decimal @default(0.1800) @db.Decimal(5, 4)
  /// Costo al momento de vender: sin esto el margen histórico es irrecuperable.
  unitCost  Decimal @default(0) @db.Decimal(12, 4)
  lineTotal Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([tenantId, saleId])
  @@index([tenantId, productId])
  @@map("sale_items")
}

/// Una venta admite varios pagos (mixto: efectivo + Yape, etc.).
model Payment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  saleId String
  sale   Sale   @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 2)
  /// Nº de operación / voucher / últimos 4 dígitos.
  reference String?
  /// Vuelto entregado (solo aplica a EFECTIVO).
  change    Decimal       @default(0) @db.Decimal(14, 2)

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([tenantId, saleId])
  @@index([tenantId, method, receivedAt])
  @@map("payments")
}

// ============================================================================
//  COTIZACIONES
// ============================================================================

model Quote {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  warehouseId String
  warehouse   Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  customerId String?
  customer   Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  number String
  status QuoteStatus @default(BORRADOR)

  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal @default(0) @db.Decimal(14, 2)
  total         Decimal @default(0) @db.Decimal(14, 2)
  currency      String  @default("PEN")

  validUntil DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuoteItem[]
  /// Venta generada al convertir la cotización (§5.4).
  sale  Sale?       @relation("QuoteToSale")

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, branchId, status, createdAt])
  @@map("quotes")
}

model QuoteItem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  quoteId String
  quote   Quote  @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  variantId String?
  variant   ProductVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  nameSnapshot String
  skuSnapshot  String
  unitType     UnitType @default(UNIDAD)

  quantity  Decimal @db.Decimal(14, 4)
  unitPrice Decimal @db.Decimal(12, 4)
  discount  Decimal @default(0) @db.Decimal(12, 4)
  taxRate   Decimal @default(0.1800) @db.Decimal(5, 4)
  lineTotal Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([tenantId, quoteId])
  @@map("quote_items")
}

// ============================================================================
//  COMPRAS (ingreso de mercadería)
// ============================================================================

model Purchase {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  warehouseId String
  warehouse   Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  supplierId String?
  supplier   Supplier? @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  number     String
  status     PurchaseStatus @default(BORRADOR)
  invoiceRef String?

  subtotal Decimal @default(0) @db.Decimal(14, 2)
  taxTotal Decimal @default(0) @db.Decimal(14, 2)
  total    Decimal @default(0) @db.Decimal(14, 2)
  currency String  @default("PEN")

  receivedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PurchaseItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  purchaseId String
  purchase   Purchase @relation(fields: [tenantId, purchaseId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  variantId String?
  variant   ProductVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  quantity  Decimal @db.Decimal(14, 4)
  unitCost  Decimal @db.Decimal(12, 4)
  taxRate   Decimal @default(0.1800) @db.Decimal(5, 4)
  lineTotal Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([tenantId, purchaseId])
  @@index([tenantId, productId])
  @@map("purchase_items")
}

// ============================================================================
//  CORRELATIVOS, CUOTAS DE PLAN Y AUDITORÍA
// ============================================================================

/// Correlativos por tenant y tipo de documento. Se incrementa DENTRO de la
/// misma transacción que crea la venta, con SELECT ... FOR UPDATE sobre la
/// fila: dos cajeros vendiendo a la vez no pueden obtener el mismo número.
model DocumentCounter {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /**
   * Sucursal dueña de esta serie.
   * NO forma parte de la clave de búsqueda, y eso es deliberado: el único
   * `(tenantId, scope, series)` de abajo garantiza que una serie pertenezca
   * a UNA sola sucursal, así que la serie ya identifica el contador por sí
   * sola. Gracias a eso `claimNextNumber` no cambió de firma y la lógica de
   * numeración sin huecos —la más delicada del proyecto— quedó intacta.
   * Si la serie formara parte de la clave junto con branchId, dos sucursales
   * podrían abrir series "B001" independientes y ambas emitirían
   * B001-00000001: correlativos solapados para un mismo RUC, que es una
   * contingencia tributaria.
   */
  branchId String
  branch   Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  scope  String // "SALE" | "QUOTE" | "PURCHASE" | "TRANSFER" | "TAX_BOLETA" | "TAX_FACTURA"
  series String @default("001")
  prefix String @default("")
  next   Int    @default(1)

  /**
   * Número con el que ARRANCÓ esta serie en este sistema.
   * Existe para poder responder una pregunta que `next` solo no responde:
   * ¿se emitió algo ya con esta serie? La respuesta es `next > startNumber`.
   * Hace falta porque un negocio que YA facturaba con otro sistema llega con
   * su serie avanzada —B001 en el 4 532, por ejemplo— y si aquí empezáramos
   * en 1 emitiríamos números YA USADOS bajo su RUC. Eso es una contingencia
   * tributaria, no un detalle de configuración.
   * Y con `next` a secas no se puede distinguir "arrancó en 1 y emitió 4 531"
   * de "arrancó en 4 532 y no ha emitido nada", que es exactamente lo que
   * decide si el arranque se puede seguir tocando.
   */
  startNumber Int @default(1)

  updatedAt DateTime @updatedAt

  @@unique([tenantId, scope, series])
  @@index([tenantId, branchId, scope])
  @@map("document_counters")
}

/// Contadores de uso por mes para el enforcement de límites del plan (§5.2).
/// `period` en formato YYYY-MM sobre el timezone del tenant.
model UsagePeriod {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  period String

  salesCount     Int @default(0)
  movementsCount Int @default(0)
  quotesCount    Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([tenantId, period])
  @@map("usage_periods")
}

/// Acciones sensibles (§6.6). tenantId es nullable porque el SUPERADMIN
/// también actúa fuera del ámbito de un tenant (ej. crear planes).
model AuditLog {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  actorId    String?
  actor      User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  Role?
  /// Congelado por si el usuario se borra después.
  actorEmail String?

  action     String // "tenant.suspend" | "plan.change" | "stock.adjust" | ...
  entityType String?
  entityId   String?

  /// Motivo obligatorio para impersonation y acciones destructivas.
  reason String?
  before Json?
  after  Json?

  ipAddress       String?
  userAgent       String?
  /// Si la acción se ejecutó durante una impersonation, queda trazada.
  impersonationId String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Soporte vía impersonation (§5.3). Requiere motivo y tiene expiración:
/// una sesión sin `endedAt` y vencida no debe otorgar acceso.
model ImpersonationSession {
  id String @id @default(cuid())

  superAdminId String
  superAdmin   User   @relation("Impersonator", fields: [superAdminId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  targetUserId String?
  targetUser   User?   @relation("Impersonated", fields: [targetUserId], references: [id], onDelete: SetNull)

  reason String

  startedAt DateTime  @default(now())
  expiresAt DateTime
  endedAt   DateTime?

  ipAddress String?
  userAgent String?

  @@index([tenantId, startedAt])
  @@index([superAdminId, startedAt])
  @@map("impersonation_sessions")
}

// ============================================================================
//  FACTURACIÓN ELECTRÓNICA
// ============================================================================

/// Comprobante de pago (boleta o factura) emitido para una venta.
///
/// ─── LO QUE ESTE MODELO SÍ RESUELVE ──────────────────────────────────────
///
/// La numeración legal (serie + correlativo sin huecos), el estado tributario
/// y la INMUTABILIDAD del documento. Un comprobante emitido no cambia nunca,
/// ni siquiera si el cliente corrige su RUC después: por eso los datos del
/// emisor y del receptor se congelan aquí en vez de leerse por relación.
///
/// ─── LO QUE NO RESUELVE ──────────────────────────────────────────────────
///
/// La firma digital y el envío a SUNAT/OSE. Eso exige certificado digital,
/// generación de XML UBL 2.1 y un proveedor autorizado — otra pieza. Los
/// campos `xmlHash`, `externalTicket` y `responseCode` están preparados para
/// recibir el resultado de ese paso cuando exista.
model TaxDocument {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Un comprobante por venta. Corregir uno emitido se hace con nota de
  /// crédito, nunca reemplazándolo — de ahí el único y no una lista.
  saleId String
  sale   Sale   @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  documentType DocumentType
  /// Serie del comprobante: "B001" para boletas, "F001" para facturas.
  series       String
  /// Correlativo SIN HUECOS dentro de (tenant, tipo, serie). El índice único
  /// de abajo es la última línea de defensa; la numeración la asigna un
  /// contador bloqueado dentro de la transacción de emisión.
  correlativo  Int
  /// Representación impresa: "F001-00000123".
  fullNumber   String

  status        TaxDocumentStatus @default(PENDIENTE)
  /// Mensaje del rechazo o de la observación, tal como lo devuelve el OSE.
  statusMessage String?

  // --- Emisor congelado al emitir ---
  issuerTaxId     String?
  issuerLegalName String?

  // --- Receptor congelado al emitir ---
  /// DNI / RUC / SIN_DOCUMENTO. Una factura exige RUC; una boleta no.
  receiverDocType   CustomerDocType @default(SIN_DOCUMENTO)
  receiverDocNumber String?
  receiverName      String?
  receiverAddress   String?

  // --- Importes congelados al emitir ---
  currency      String  @default("PEN")
  /// Base imponible.
  subtotal      Decimal @db.Decimal(14, 2)
  /// IGV.
  taxTotal      Decimal @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  total         Decimal @db.Decimal(14, 2)

  // --- Pista de la integración fiscal (se rellena en la fase de firma) ---
  xmlHash        String?
  externalTicket String?
  responseCode   String?

  issuedAt   DateTime  @default(now())
  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?
  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, saleId])
  /// La restricción LEGAL: no puede haber dos comprobantes con el mismo
  /// tipo, serie y correlativo en un mismo negocio.
  @@unique([tenantId, documentType, series, correlativo])
  @@index([tenantId, status, issuedAt])
  @@index([tenantId, documentType, series])
  @@map("tax_documents")
}

/**
 * Catálogo de ubigeo del INEI.
 * GLOBAL, sin `tenantId`: es un catálogo del Estado peruano, igual para todos
 * los negocios. Va en la base y no en un fichero del bundle porque son ~2 100
 * filas que el selector consulta por nivel, y embarcarlas en el JavaScript del
 * cliente las descargaría enteras en cada visita para mostrar 25.
 * Se carga con `scripts/cargar-ubigeo.ts`, que VALIDA antes de escribir y no
 * carga nada si la validación falla (ver src/features/ubigeo/validar.ts).
 */
model Ubigeo {
  /// 6 dígitos: departamento(2) + provincia(2) + distrito(2).
  codigo String @id

  nombre String
  /// 1 departamento, 2 provincia, 3 distrito.
  nivel  Int

  /**
   * Código del padre: NULL en los departamentos. Se guarda explícito aunque
   * sea derivable del propio código, porque así el selector en cascada lo
   * consulta por índice en vez de con un LIKE sobre un prefijo.
   */
  padre String?

  /// Versión del catálogo cargado, para saber de qué año son los datos.
  version String

  createdAt DateTime @default(now())

  @@index([nivel, nombre])
  @@index([padre])
  @@map("ubigeos")
}

/**
 * Merma solicitada, pendiente de aprobación.
 * ─── POR QUÉ NO ES UN StockMovement DIRECTO ──────────────────────────────
 * Porque mientras está PENDIENTE **el stock no se ha movido**. Un
 * StockMovement es el asiento de algo que ya pasó; esto es una petición.
 * Mezclarlas obligaría a tener movimientos que no cuentan para el saldo, y
 * entonces `SUM(movimientos) = stock` —el invariante que sostiene todo el
 * inventario— dejaría de cumplirse.
 * Al aprobarse SÍ se crea el StockMovement, y es ese asiento el que mueve el
 * saldo.
 */
model Merma {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  warehouseId String
  warehouse   Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  variantId String?
  variant   ProductVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  /// Congelados al solicitar: el catálogo puede cambiar antes de aprobarse.
  nameSnapshot String
  skuSnapshot  String
  unitType     UnitType @default(UNIDAD)

  quantity Decimal @db.Decimal(14, 4)
  /// Motivo OBLIGATORIO: una merma sin explicación no es auditable.
  reason   String

  /**
   * Foto opcional como evidencia. Se guarda la URL, no el binario: meter
   * imágenes en Postgres infla la base y las copias de seguridad por un dato
   * que un almacén de objetos sirve mejor.
   */
  photoUrl String?

  status MermaStatus @default(PENDIENTE)

  requestedById String
  requestedBy   User    @relation("MermaRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  resolvedById  String?
  resolvedBy    User?   @relation("MermaResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  /// Motivo del rechazo. Rechazar sin explicar no le sirve a quien la pidió.
  rejectReason String?

  /// Movimiento que se creó al aprobarla. NULL mientras esté pendiente.
  movementId String?

  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  /// El contador del panel consulta por aquí: (tenant, estado).
  @@index([tenantId, status, requestedAt])
  @@index([tenantId, branchId, status])
  @@index([tenantId, productId])
  @@map("mermas")
}

// ═══════════════════════════════════════════════════════════════════════════
//  SUCURSALES
// ═══════════════════════════════════════════════════════════════════════════

/**
 * Sucursal: un establecimiento del negocio.
 * Es una entidad distinta del almacén a propósito. SUNAT numera por
 * ESTABLECIMIENTO, no por depósito: una tienda con sala de ventas y almacén
 * trasero es un solo establecimiento con dos almacenes, y emite una sola
 * serie de comprobantes. Si la sucursal fuese el almacén, esa tienda
 * declararía dos establecimientos inexistentes.
 */
model Branch {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Código interno, el que usa el personal: "LIMA01", "SJL".
  code String
  name String

  /**
   * Código de establecimiento anexo ante SUNAT: cuatro dígitos, "0000" para
   * la casa matriz. Único dentro del tenant y SIN índice parcial: una
   * sucursal dada de baja conserva el suyo a propósito, porque los
   * comprobantes que emitió siguen apuntando a ese establecimiento y SUNAT no
   * admite reutilizar el código con otro local.
   */
  establishmentCode String

  /**
   * Número de serie de esta sucursal, de 1 a 999.
   * De aquí sale la serie de TODOS sus documentos: la sucursal 1 emite V001,
   * C001, B001 y F001; la sucursal 2 emite V002, C002, B002 y F002. Al ser
   * único por tenant, dos sucursales no pueden colisionar en una serie, que
   * es justo lo que produciría correlativos duplicados bajo un mismo RUC.
   * Es también lo que hace la migración retrocompatible: los datos que ya
   * existían usan la serie "001", así que la sucursal creada en el backfill
   * recibe seriesNumber = 1 y ni un solo número cambia.
   */
  seriesNumber Int

  address String?
  /// Ubigeo INEI: 6 dígitos (departamento + provincia + distrito).
  ubigeo  String?
  phone   String?
  email   String?

  /// Responsable del local. SetNull: si el encargado se va, la sucursal sigue.
  managerId String?
  manager   User?   @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)

  /// Casa matriz / sucursal por defecto del POS. Exactamente una por tenant.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete: nunca se borra una sucursal con historial (Frente 1).
  deletedAt DateTime?

  warehouses   Warehouse[]
  users        UserBranch[]
  counters     DocumentCounter[]
  sales        Sale[]
  quotes       Quote[]
  cashSessions CashSession[]
  transfersOut BranchTransfer[]  @relation("TransferFrom")
  transfersIn  BranchTransfer[]  @relation("TransferTo")
  mermas       Merma[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, establishmentCode])
  @@unique([tenantId, seriesNumber])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
  @@map("branches")
}

/**
 * A qué sucursales puede entrar cada usuario.
 * Tabla puente y no una columna en User porque el pliego pide que un usuario
 * pueda estar asignado a UNA O VARIAS: el contador entra a todas, el cajero
 * solo a la suya.
 * Importante: esto es permiso de acceso, no aislamiento de datos. El
 * aislamiento sigue viniendo de `tenantId` y de las FK compuestas; esta tabla
 * decide qué sucursal puede operar un usuario DENTRO de su tenant.
 */
model UserBranch {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  branchId String
  branch   Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  createdAt DateTime @default(now())

  @@id([tenantId, userId, branchId])
  @@index([tenantId, branchId])
  @@map("user_branches")
}

/**
 * Turno de caja: apertura, cierre y arqueo.
 * El descuadre se guarda CALCULADO y congelado, no derivado al leer. Si se
 * recalculara, una venta anulada al día siguiente alteraría el arqueo de un
 * turno ya cerrado y firmado por el cajero, y entonces el arqueo dejaría de
 * ser prueba de nada.
 */
model CashSession {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  openedById String
  openedBy   User    @relation("CashOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedById String?
  closedBy   User?   @relation("CashClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  status CashSessionStatus @default(ABIERTA)

  /// Fondo de cambio con el que arranca el turno.
  openingAmount Decimal @db.Decimal(14, 2)

  /// Efectivo físico contado al cerrar. NULL mientras el turno está abierto.
  countedAmount  Decimal? @db.Decimal(14, 2)
  /// Lo que el sistema esperaba: fondo + cobros en efectivo - vueltos.
  expectedAmount Decimal? @db.Decimal(14, 2)
  /// contado - esperado. Negativo es faltante; positivo, sobrante.
  difference     Decimal? @db.Decimal(14, 2)

  /// Totales congelados al cerrar, para el reporte del turno.
  salesCount  Int     @default(0)
  salesTotal  Decimal @default(0) @db.Decimal(14, 2)
  cashTotal   Decimal @default(0) @db.Decimal(14, 2)
  changeTotal Decimal @default(0) @db.Decimal(14, 2)

  openingNotes String?
  closingNotes String?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@unique([tenantId, id])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, openedAt])
  @@map("cash_sessions")
}

/**
 * Transferencia de mercadería entre sucursales.
 * El stock se mueve en DOS pasos atómicos y no en uno: sale del origen al
 * despachar y entra al destino al recibir. Un único movimiento instantáneo
 * mentiría durante todo el tiempo que la mercadería va en la camioneta, y es
 * precisamente ahí donde se pierde.
 */
model BranchTransfer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Correlativo propio (scope TRANSFER), con la serie de la sucursal origen.
  number String

  fromBranchId    String
  fromBranch      Branch @relation("TransferFrom", fields: [tenantId, fromBranchId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  /// Almacén concreto del que sale la mercadería.
  fromWarehouseId String

  toBranchId    String
  toBranch      Branch @relation("TransferTo", fields: [tenantId, toBranchId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  /// Almacén concreto al que entra. Se fija al crear y se usa al recibir.
  toWarehouseId String

  status TransferStatus @default(BORRADOR)

  requestedById String
  requestedBy   User    @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById  String?
  approvedBy    User?   @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  receivedById  String?
  receivedBy    User?   @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  shippedAt   DateTime?
  receivedAt  DateTime?

  notes        String?
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items BranchTransferItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status, requestedAt])
  @@index([tenantId, fromBranchId, status])
  @@index([tenantId, toBranchId, status])
  @@map("branch_transfers")
}

model BranchTransferItem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  transferId String
  transfer   BranchTransfer @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  variantId String?
  variant   ProductVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  nameSnapshot String
  skuSnapshot  String
  unitType     UnitType @default(UNIDAD)

  quantitySent     Decimal  @db.Decimal(14, 4)
  /**
   * Lo que el destino dice haber recibido. Puede ser MENOR que lo enviado:
   * ahí está el valor del arqueo de transferencias. La diferencia no se
   * reparte en silencio — queda registrada y el faltante se asienta como
   * merma en el origen.
   */
  quantityReceived Decimal? @db.Decimal(14, 4)

  createdAt DateTime @default(now())

  @@index([tenantId, transferId])
  @@index([tenantId, productId])
  @@map("branch_transfer_items")
}
